{
  "expo": {
    "name": "Nelo",
    "slug": "nelo",
    "scheme": "nelo",
    "version": "0.1.0",
    "description": "A simple and reassuring companion for parents.",
    "orientation": "portrait",
    "icon": "./assets/icons/logo.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thomasboudru.nelo",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 1,
      "package": "com.thomasboudru.nelo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/logo.png",
        "backgroundColor": "#DCEFFC"
      }
    },
    "web": {
      "favicon": "./assets/icons/favicon_nelo.png"
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DCEFFC",
          "image": "./assets/icons/splash.png",
          "imageWidth": 190
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.461926871954-o3t2vg867n97ei4iegj0sp4934rknif8"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d89894a2-535f-453a-a165-f1096c0aa00e"
      }
    }
  }
}
