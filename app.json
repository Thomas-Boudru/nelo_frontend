{
  "expo": {
    "name": "Nelo",
    "slug": "nelo",
    "scheme": "nelo",
    "version": "0.1.0",
    "description": "A simple and reassuring companion for parents.",
    "orientation": "portrait",
    "icon": "./assets/icons/splash.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thomasboudru.nelo"
    },
    "android": {
      "versionCode": 1,
      "package": "com.thomasboudru.nelo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/logo.png",
        "backgroundColor": "#DCEFFC"
      }
    },
    "web": {
      "favicon": "./assets/icons/favicon_nelo.png"
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DCEFFC",
          "image": "./assets/icons/splash.png",
          "imageWidth": 190
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ]
  }
}
