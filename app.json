{
  "expo": {
    "name": "Numi",
    "slug": "numi",
    "scheme": "numi",
    "privacy": "public",
    "version": "0.1.0",
    "description": "Personal document assistant.",
    "orientation": "portrait",
    "icon": "./assets/icons/splash_numi.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thomasboudru.numi"
    },
    "android": {
      "versionCode": 1,
      "package": "com.thomasboudru.numi",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/splash_numi.png",
        "backgroundColor": "#E699F5"
      }
    },
    "web": {
      "favicon": "./assets/icons/logo.png"
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E699F5",
          "image": "./assets/icons/splash_numi.png",
          "imageWidth": 190
        }
      ]
    ]
  }
}
